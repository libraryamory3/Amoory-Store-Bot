# ==================== Bot Configuration ====================
# احصل على BOT_TOKEN من @BotFather في Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram ID للمالك (صاحب المتجر)
# احصل عليه بإرسال /id للبوت أو من @userinfobot
OWNER_ID=YOUR_TELEGRAM_ID_HERE

# ==================== Store Configuration ====================
# حد المخزون المنخفض الذي يتم إرسال تنبيه عند الوصول إليه
LOW_STOCK_THRESHOLD=5

# ==================== Database Configuration ====================
# اسم قاعدة البيانات SQLite
DATABASE_NAME=amoory_store.db

# ==================== Backup Configuration ====================
# مجلد النسخ الاحتياطية
BACKUP_DIR=backups

# ==================== Logging Configuration ====================
# مستوى السجلات (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
